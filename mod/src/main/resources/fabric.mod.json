{
  "schemaVersion": 1,
  "id": "mcmod",
  "version": "${version}",
  "name": "MC Mod",
  "description": "A custom Minecraft mod built with Fabric",
  "authors": [
    "Your Name"
  ],
  "contact": {
    "homepage": "https://github.com/yourusername/mcmod",
    "sources": "https://github.com/yourusername/mcmod"
  },
  "license": "MIT",
  "icon": "assets/mcmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.mcmod.MCMod"
    ],
    "client": [
      "com.example.mcmod.MCModClient"
    ]
  },
  "mixins": [
    "mcmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.4",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
} 